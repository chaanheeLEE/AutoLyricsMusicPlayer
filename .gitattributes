# Auto-detect text files and normalize line endings to LF across Windows and Linux CI
* text=auto eol=lf

# Explicit LF for source, config, and markdown docs
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary assets
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.onnx binary
*.wav binary
*.mp3 binary
*.flac binary
*.m4a binary
